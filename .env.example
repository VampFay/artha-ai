# ─────────────────────────────────────────────────────────────────────
# ARTHA — Environment Variable Template
# Copy to .env (dev) or .env.production (prod) and fill in real values.
# NEVER commit .env or .env.production to git.
# ─────────────────────────────────────────────────────────────────────

# ── Database (Phase 1) ────────────────────────────────────────────────
# SQLite (dev only — single user, no concurrent writes):
# DATABASE_URL=file:./db/custom.db
# Postgres local (via docker-compose):
DATABASE_URL=postgresql://artha:artha@localhost:5432/artha
# Postgres managed (pick one):
# Supabase:  postgresql://postgres.<ref>:<pass>@db.<ref>.supabase.co:5432/postgres
# Neon:      postgresql://<user>:<pass>@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Railway:   postgresql://postgres:<pass>@monorail.proxy.rlwy.net:<port>/db
# Direct URL for Prisma migrations (no PgBouncer):
DIRECT_URL=postgresql://artha:artha@localhost:5432/artha

# ── Auth / Crypto (Phase 4) ───────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-64-char-minimum-secret-from-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-a-different-64-char-secret
# AES-256-GCM field-level encryption key (32 bytes hex): openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
# AWS KMS key alias for envelope encryption (Phase 9 — optional in dev)
KMS_KEY_ID=alias/artha-prod

# ── Storage (Phase 3) ─────────────────────────────────────────────────
STORAGE_DRIVER=local   # local | s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Only for Cloudflare R2:
S3_ENDPOINT=

# ── Cache + Queue (Phase 5) ───────────────────────────────────────────
REDIS_URL=redis://default:artha@localhost:6379
# Leave empty to use in-memory fallback (dev only — breaks in multi-instance)

# ── AI / LLM ──────────────────────────────────────────────────────────
ZAI_API_KEY=

# ── Observability (Phase 7) ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=

# ── Email (Phase 6 — optional, email module falls back to console) ────
MAIL_DRIVER=console   # console | ses | smtp
SES_REGION=ap-south-1
MAIL_FROM="Artha <noreply@artha.ai>"
# SMTP fallback:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1
LOG_LEVEL=info   # trace | debug | info | warn | error | fatal

# ── Maintenance (Phase 6) ────────────────────────────────────────────
MAINTENANCE_MODE=false   # set true to serve src/app/maintenance/page.tsx
